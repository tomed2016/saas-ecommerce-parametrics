{
  "name": "saas-ecommerce-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/seed.ts",
    "outbox:worker": "ts-node --transpile-only -r tsconfig-paths/register src/infra/outbox.worker.ts",
    "test:outbox": "ts-node --transpile-only -r tsconfig-paths/register ../../tools/test/test-outbox.ts",
    "test:catalog-outbox": "ts-node --transpile-only -r tsconfig-paths/register ../../tools/test/test-catalog-outbox.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "engines": {
    "node": "^18 || ^20"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^0.10.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "jsonwebtoken": "^9.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.10.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.0",
    "speakeasy": "^2.0.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "^20.0.0",
    "testcontainers": "^9.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
