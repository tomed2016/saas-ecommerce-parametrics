# Root .gitignore for saas-ecommerce-parametrics monorepo

# --- Node / JavaScript ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles (keep if you want deterministic installs; uncomment if you prefer to ignore)
# package-lock.json
# yarn.lock

# Build outputs
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.*
.env.local

# Logs
logs/
*.log

# --- Docker ---
# Ignore local docker-compose volume data (Postgres data dir used by compose)
infrastructure/docker-compose/pgdata/

# --- IDEs and editors ---
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath

# --- OS files ---
.DS_Store
Thumbs.db

# --- Java / Maven ---
target/
**/target/
*.class
*.jar
*.war

# Keep the maven wrapper jar checked in
!/.mvn/wrapper/maven-wrapper.jar

# --- Misc / caches ---
.cache/
.parcel-cache/
.next/
.vite/
.turbo/
.serverless/
test-results/
jest-cache/

# Testcontainers / temporary test files
.testcontainers/

# Local config
local-*.json

# Helpfull ignores for editors and OS
*.swp
*~

